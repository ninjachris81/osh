#!/bin/bash
set -e

CONFIG_FILE="/boot/firmware/config.txt"

PARAMS_TO_ADD=(
    "dtoverlay=pi3-disable-wifi"
    "dtoverlay=pi3-disable-bt"
    "disable_splash=1"
    "dtparam=sys_led_trigger=none"
    "dtparam=sys_led_activelow=off"
    "dtparam=pwr_led_trigger=default-on"
    "dtparam=pwr_led_activelow=off"
    "initial_turbo=30"
)

# Helper function to safely add a parameter if it doesn't exist
add_param_if_missing() {
    local param="$1"
    local key="${param%%=*}"
    local value="${param#*=}"
    if ! grep -Eq "^[[:space:]]*${key}[[:space:]]*=[[:space:]]*${value}[[:space:]]*$" "$CONFIG_FILE"; then
        printf '%s\n' "$param" >> "$CONFIG_FILE"
    fi
}

# Ensure the config file exists before writing to it
if [ -f "$CONFIG_FILE" ]; then
    # Add a header section if it is completely missing
    if ! grep -q "# My Custom Settings" "$CONFIG_FILE"; then
        printf '\n# My Custom Settings\n' >> "$CONFIG_FILE"
    fi

    # Check and append each parameter individually
    for param in "${PARAMS_TO_ADD[@]}"; do
        add_param_if_missing "$param"
    done

fi

exit 0
