[Unit]
Description=OSH ShutterService-eg Service
## make sure we only start the service after network is up
Wants=network-online.target
After=network.target postgresql.service

[Service]
## use 'Type=forking' if the service backgrounds itself
## other values are Type=simple (default) and Type=oneshot
#Type=forking
Type=simple
Restart=on-failure
RestartSec=5s

WorkingDirectory=/etc/osh/instances/ShutterService-eg

## here we can set custom environment variables
ExecStart=/etc/osh/instances/ShutterService-eg/start.sh

# Useful during debugging; remove it once the service is working
#StandardOutput=file:/var/log/osh_shutter_service_eg.log
#StandardError=syslog

[Install]
WantedBy=multi-user.target
