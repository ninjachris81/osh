[Unit]
Description=OSH EnergyMeter Air Conditioning for DG Service
## make sure we only start the service after network is up
Wants=network-online.target
After=network.target dev-tty_energyMeter2.device
BindsTo=dev-tty_energyMeter2.device

[Service]
## use 'Type=forking' if the service backgrounds itself
## other values are Type=simple (default) and Type=oneshot
#Type=forking
Type=simple
Restart=on-failure
RestartSec=5s
Environment="LD_LIBRARY_PATH=/usr/local/qt6/lib"

WorkingDirectory=/etc/osh/instances/RS485EnergyMeterService-acdg

#User=root

## here we can set custom environment variables
ExecStart=/etc/osh/instances/RS485EnergyMeterService-acdg/start.sh

# Useful during debugging; remove it once the service is working
#StandardOutput=file:/var/log/osh_rs485_energymeter_acdg_service.log
#StandardError=syslog

[Install]
WantedBy=multi-user.target
