[Unit]
Description=OSH RS232 Input Service
## make sure we only start the service after network is up
Wants=network-online.target
After=network.target

[Service]
## use 'Type=forking' if the service backgrounds itself
## other values are Type=simple (default) and Type=oneshot
#Type=forking
Type=simple
Restart=on-failure
RestartSec=5s
Environment="LD_LIBRARY_PATH=/usr/local/qt6/lib"

WorkingDirectory=/etc/osh/instances/RS232InputService

#User=root

## here we can set custom environment variables
ExecStart=/etc/osh/instances/RS232InputService/start.sh

# Useful during debugging; remove it once the service is working
#StandardOutput=file:/var/log/osh_rs232_input_service.log
#StandardError=syslog

[Install]
WantedBy=multi-user.target
