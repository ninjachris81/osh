    "version": "0.2.0",
    "configurations": [
    {
        "name": "(gdb) RS485EnergyMeterService",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build/RS485EnergyMeterService/RS485EnergyMeterService",
        "args": [
            "${workspaceFolder}/deploy/wsl/configs/RS485EnergyMeterService/config.ini"
        ],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    },
